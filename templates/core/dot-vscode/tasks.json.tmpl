{
  // THIS FILE IS USUALLY EMPTY, AND THAT IS THE INTENDED STATE.
  //
  // Nearly every task a project needs is defined ONCE in
  // `alex-projects.code-workspace` and takes the project as an `${input:project}`
  // argument, routed through devkit's `devkit_project.py`. Testing, linting, the
  // vendored-harness hook tests, the drift check, the agent-context sync, the git
  // sync, starting and stopping this project's Docker stack, Docker daemon recovery,
  // ports, and every shipping step already exist there. None of them belong here.
  //
  // THE BAR FOR ADDING A TASK TO THIS FILE: a picker, a composite, or a GUI launch
  // has to add something a workspace task with `--project` cannot. A one-line
  // invocation of a documented script does NOT qualify — the script is already the
  // interface, and a copy here is one more place to drift.
  //
  // That bar is not theoretical. This template used to ship five tasks; applying it
  // removed four, and applying it across the live checkouts removed sixteen. What
  // the copies cost:
  //
  //   - "Project: New from devkit" existed at user AND project level with different
  //     flags, so which GitHub repo you got depended on which window you were in.
  //   - carameli's frontend-preview composite (three task entries) opened
  //     `localhost:5174`; ports.toml allocates 5173 to that checkout and 5175 to its
  //     worktree, so it had never once pointed at a running server in either.
  //
  // What this project owes the arrangement instead is the CLI CONTRACT: keep
  // `scripts/run-tests.py`, `scripts/lint-all.py`, `scripts/docker-up.py`,
  // `scripts/docker-down.py`, `scripts/sync-agents-context.py` and
  // `scripts/sync-devkit.py` at those paths, accepting their usual arguments.
  // `devkit_project.py --check` reports any checkout that has stopped satisfying it.
  // The scripts stay per-project on purpose — lint scope, test scope and compose
  // topology genuinely differ — which is why they live in `templates/` and not in
  // `sync-devkit.py`'s MANIFEST.
  //
  // Conventions for anything that does clear the bar: label `"Domain: Title Case
  // Action"`; every task carries a `detail` (the second line of the quick-pick, and
  // the only place a one-click action can state its cost or blast radius);
  // `"type": "process"` so VS Code monitors the process directly and the exit-code
  // icon stays truthful; `notify-wrap.py` for the completion toast; and every
  // `${input:...}` picker supplies one real token in every branch, because an empty
  // string reaches argparse as a stray positional and is rejected.
  "version": "2.0.0",
  "tasks": [
{{#alembic}}
    {
      "label": "DB: New Migration (Autogenerate)",
      "detail": "`alembic revision --autogenerate` from the current model diff. ALWAYS read the generated file before committing it — autogenerate misses renames and constraint changes. Earns its place here because the message is a free-text prompt and the revision is per-project.",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "DB: New Migration", "--", "python", "-m", "alembic", "revision", "--autogenerate", "-m", "${input:migrationMessage}"],
      "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    }
{{/alembic}}
  ],
  "inputs": [
{{#alembic}}
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Short description of the schema change (becomes the migration filename)",
      "default": ""
    }
{{/alembic}}
  ]
}
