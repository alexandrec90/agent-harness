# Per-project config for the vendored agent-harness hook scripts
# (scripts/hooks/*.py). Those scripts are byte-identical across every project;
# everything project-specific lives here. Loaded by scripts/hooks/harness_config.py.
# Schema + neutral defaults: that module's dataclasses.
#
# Generated by devkit's `new-project.py`. This file is deliberately NOT in
# sync-harness.py's MANIFEST — it is the per-project seam, so editing it here is
# correct and will never be reported as drift.

[project]
# Prefix for the harness control env vars:
#   {{ env_prefix }}_SKIP_STOP_VERIFY, {{ env_prefix }}_STOP_TESTS_AUTOSTART,
#   {{ env_prefix }}_NORMALIZE_KNOWN_FIXES_ON_STOP
env_prefix = "{{ env_prefix }}"

[paths]
app = "{{ app_dir }}"
tests = "{{ tests_dir }}"
unit_tests = "{{ unit_tests }}"

[stop]
# State-driven skills finalized on every Stop, as [skill, schema] pairs. Empty
# until this project adopts skills that carry state — an entry naming a skill that
# does not exist makes the Stop hook do nothing useful every single turn.
finalize_targets = []

{{#postgres}}
# Tier 2b: host pytest against the DB over its published compose port.
#
# NOTE the port. `db_port` is the *host* port, so it differs per worktree — this
# file is committed and shared across worktrees, which means the value below is
# only right for the primary checkout. A worktree stack publishes
# `{{ db_port }} + its slot` (see devkit's ports.toml); if you run host pytest from
# a worktree, export DB_HOST_PORT to override.
[db]
enabled = true
services = [{{ db_services_toml }}]
db_service = "db"
db_port = {{ db_port }}
{{#redis}}
redis_service = "redis"
redis_port = {{ redis_port }}
{{/redis}}
# Mirrors docker-compose.yml's POSTGRES_* and the PR gate's env block.
user = "{{ db_user }}"
password = "{{ db_password }}" # pragma: allowlist secret
name = "{{ db_name }}"
url_scheme = "{{ db_url_scheme }}"
url_env = ["DATABASE_URL"]
{{#redis}}
redis_env = "REDIS_URL"
{{/redis}}

# Extra env for host pytest: name -> default. An already-set os.environ wins.
[db.test_env]
{{/postgres}}
{{^postgres}}
# No DB tier: the Stop hook runs lint + the script tests only. Turn this on by
# setting `enabled = true` under a [db] table once a compose DB service exists.
[db]
enabled = false
{{/postgres}}

{{#frontend}}
# Tier 3: vitest when frontend/src changed, typecheck when types changed.
#
# OFF on arrival, deliberately. The `frontend` feature wires the compose service
# (it bind-mounts ./frontend and runs `npm run dev`), but the generator scaffolds
# no frontend source tree -- that is yours to bring. Until it exists, this tier
# cannot work and cannot say so: `stop.py` gates it with
# `path.startswith(CFG.src)`, so an `src` naming a directory that is not there
# never matches a changed file and the tier silently never fires. That is the
# failure `scripts/hooks/tests/test_repo_contract.py` exists to make loud, and it
# holds the paths below to being real the moment you flip this to true.
#
# So: scaffold frontend/ (Vite + vitest, with `test:run` and `typecheck` scripts),
# then set enabled = true.
[frontend]
enabled = false
dir = "frontend"
src = "frontend/src/"
skin = "frontend/src"
test_cmd = ["run", "test:run"]
typecheck_cmd = ["run", "typecheck"]
{{/frontend}}
{{^frontend}}
[frontend]
enabled = false
{{/frontend}}
