// Canonical shared task block — devkit owns this; alex-projects.code-workspace
// carries a copy under its "tasks" key. Edit the workspace file, then adopt the
// change here:
//
//     python scripts/devkit_project.py --adopt-tasks
//
// and verify with `--check-tasks`. The workspace file is not inside any repo, so it
// cannot be vendored the way sync-devkit.py's MANIFEST files are; this pairing is the
// drift check that replaces that. Comparison is semantic (parsed), not byte-for-byte.
{
	"version": "2.0.0",
	"tasks": [
		// --- generic: pick a project ---------------------------------------
		{
			"label": "Test: Run Suite",
			"detail": "The chosen project's own test suite, via its scripts/run-tests.py. Failures go to that project's logs/test-failures.log — read the artifact, not the terminal.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"test",
				"${input:testScope}"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"icon": {
				"id": "beaker",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Harness Hook Tests — free",
			"detail": "The vendored tier's own stdlib-only tests in the chosen project. Separate from 'Test: Run Suite' because pytest's testpaths deliberately excludes scripts/hooks/tests/ in EVERY consumer — that exclusion is why this needs its own runner. Fails loudly on a checkout that does not vendor the harness rather than reporting green having run nothing.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"test-hooks"
			],
			"group": "test",
			// Not `beaker`/green: that is "Test: Run Suite", and the two sat
			// side by side in the picker as an identical icon under two labels.
			"icon": {
				"id": "zap",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Lint: Everything",
			"detail": "Full-repo lint for the chosen project, via its scripts/lint-all.py. Findings go to that project's logs/lint-errors.log — read the artifact, not the terminal.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"lint"
			],
			"group": "build",
			"icon": {
				"id": "checklist",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Lint: Changed Files",
			"detail": "Lint only the working-tree diff (vs HEAD, plus untracked) in the chosen project. Same artifact as 'Lint: Everything'.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"lint-changed"
			],
			"group": "build",
			// Same reason as the hook tests above — `checklist`/yellow is
			// "Lint: Everything"; the narrower scope gets the narrower icon.
			"icon": {
				"id": "list-selection",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Agent: Sync Codex Context",
			"detail": "Regenerate Codex repository skills and hook configuration from the Claude-side sources in the chosen project.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-codex"
			],
			"icon": {
				"id": "sync",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Harness: Check Drift vs devkit",
			"detail": "Byte-compares the chosen project's vendored scripts/hooks/ against devkit. Needs DEVKIT_DIR set — if it prints 'nothing to do (skipping)', it is checking NOTHING, which is the failure mode this task exists to make visible. Defaults to the read-only check; --pull and --push both rewrite files.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-devkit",
				"${input:harnessMode}"
			],
			"icon": {
				"id": "diff",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Git: Sync Branch onto Origin Default (Keep Changes)",
			"detail": "Detects origin's default branch (master/main), then fetch → stash if dirty → rebase → pop. Keeps unstaged/untracked changes. Runs in the project you pick, not in whatever file happens to be focused.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"sync-branch"
			],
			"icon": {
				"id": "git-merge",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		// --- generic: Docker ------------------------------------------------
		// Two kinds live here. The first two are STACK-scoped: they act on the
		// chosen project's own compose topology, which genuinely differs (carameli
		// waits on healthchecks, ibkr_trader scopes to its ibkr/app profiles), so
		// they delegate to that project's script and the shared thing is the CLI
		// contract. The rest are DAEMON-scoped — one Docker Desktop per machine —
		// and delegate only so a project can override the teardown.
		{
			"label": "Docker: Start Stack",
			"detail": "Build and start the chosen project's stack, then wait for healthchecks. The default build task (Ctrl+Shift+B). Delegates to that project's scripts/docker-up.py; a checkout with no Docker tier says so by name rather than failing on a missing file.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-up"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"icon": {
				"id": "vm-running",
				"color": "terminal.ansiGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Stop Stack",
			"detail": "Stop the chosen project's containers. Named volumes and the data in them survive — this is `down`, never `down -v`.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-down"
			],
			"icon": {
				"id": "vm-outline",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Restart Engine",
			"detail": "Unsticks a daemon hung on 'Starting the Docker Engine': kill processes → wsl --shutdown → relaunch → poll until `docker info` answers. Uses the chosen project's own scripts/docker-restart-engine.py when it ships one.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-restart-engine"
			],
			"icon": {
				"id": "debug-restart",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Fix Stalled Desktop",
			"detail": "The aggressive escalation from 'Restart Engine' — two stop/start rounds and a doubled poll window, for a Docker Desktop that never finishes starting. Uses the chosen project's own scripts/docker-fix.py when it ships one.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-fix"
			],
			"icon": {
				"id": "tools",
				"color": "terminal.ansiYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Docker: Prune + Compact VHDX",
			"detail": "Reclaims image/build-cache space, then compacts the WSL2 VHDX so the space returns to Windows (needs an elevated shell for that last step). Never touches named volumes. Delegates to the chosen project's own prune script — carameli's and ibkr_trader's each tear down and restore their own stack.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:project}",
				"docker-prune"
			],
			"icon": {
				"id": "trash",
				"color": "terminal.ansiRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		// --- scoped: carameli's worktree pair --------------------------------
		// These three came up out of `carameli/.vscode/tasks.json`. The picker lists
		// two checkouts rather than five because that is what the action is defined
		// for — see `Action.projects` in devkit_project.py.
		{
			"label": "Test: Run Carameli Target — free",
			"detail": "A Carameli-only free target in the chosen carameli checkout. Distinct from 'Test: Run Suite', which is pytest alone: '--all' here merges pytest + hooks + frontend into ONE artifact, and that single writer is what keeps the aggregate from racing itself. Paid tiers (telnyx-sandbox, telnyx-chargeable, live-e2e) are absent on purpose and stay opt-in on the CLI.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"test-target",
				"${input:carameliTestTarget}"
			],
			// Deliberately not `isDefault`: "Test: Run Suite" holds that, and two
			// defaults in one multi-root workspace makes Run Test Task ambiguous.
			// That collision was real while this task lived in the repo.
			"group": "test",
			"icon": {
				"id": "beaker",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Test: Run Browser E2E — free",
			"detail": "Playwright against the chosen carameli checkout — headless, headed, or across Chromium/Firefox/WebKit. NEEDS THE STACK UP FIRST: run 'Docker: Start Stack' for the same checkout, plus the Vite dev server. Failures go to that checkout's logs/e2e-failures.log — read the artifact, not the terminal.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"e2e",
				"${input:e2eMode}"
			],
			"group": "test",
			"icon": {
				"id": "browser",
				"color": "terminal.ansiBrightGreen"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			// This one was deleted from carameli's task file for being a one-line
			// wrapper around a documented script, under the old rule that a
			// PROJECT-level task had to justify its copy. That rule is gone with the
			// files it governed: there is no copy here to drift, so a one-click
			// tunnel-plus-resync costs nothing and the script stays the interface.
			"label": "Start: ngrok + Sync Webhook URLs",
			"detail": "Open the ngrok tunnel for the chosen carameli checkout, write the new public URL into its webhook environment values, and RECREATE app + worker so they pick it up. Recreating containers interrupts anything in flight against them; the tunnel URL changes on every run, so any provider-side callback still pointing at the old one goes dead.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:carameliCheckout}",
				"ngrok"
			],
			"icon": {
				"id": "radio-tower",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- scoped: ibkr_trader's worktree pair -----------------------------
		// The five that came up out of `ibkr_trader/.vscode/tasks.json`. Each routes
		// through a `scripts/*.py` in that repo, which is what makes them dispatchable
		// at all — the two Backtest tasks named `.venv\Scripts\ibkr-trader.exe`
		// directly and needed `scripts/backtest-task.py` written before they could
		// move. Note there is no "Docker: Start Stack" story here: that project keeps
		// containers OFF by default, and the generic task says so by name.
		{
			"label": "IBKR: Open Gateway VNC Viewer",
			"detail": "Attach TigerVNC to the paper gateway in the chosen ibkr_trader checkout, for login and 2FA prompts. Needs the `ibkr` profile already up — this only opens a viewer. The VNC password is copied out of the container's own auth file, never read in plaintext on the host; if that fails the viewer just prompts.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"vnc",
				"${env:ProgramFiles}\\TigerVNC\\vncviewer.exe"
			],
			"icon": {
				"id": "device-desktop",
				"color": "terminal.ansiBrightBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ingest: Run Source",
			"detail": "One source pull in the chosen ibkr_trader checkout. Thirteen sources behind one picker; the free-text argument is used only by the single-symbol, single-keyword and FX-pair modes and ignored by the batch ones. Needs the `db` container up. Output goes to that checkout's artifacts/tasks/ingest-*.log.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"ingest",
				"${input:ingestSource}",
				"--arg=${input:ingestArg}"
			],
			"icon": {
				"id": "cloud-download",
				"color": "terminal.ansiBrightCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Snapshot: Run Monthly",
			"detail": "The whole monthly forward-shadow ritual for the chosen ibkr_trader checkout, in one step: Postgres up, migrations, FMP + Yahoo prices, ticker aggregation, then `snapshot run --all`. Stops at the first unrecoverable failure and writes it to artifacts/tasks/snapshot-monthly.log — read the artifact, not the terminal. STARTS a container and does NOT stop it afterwards; that machine keeps containers down by default, so put it back.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"snapshot-monthly",
				"${input:snapshotScope}"
			],
			"icon": {
				"id": "calendar",
				"color": "terminal.ansiBrightYellow"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Backtest: Run",
			"detail": "Simulate one allocator over one universe in the chosen ibkr_trader checkout. Six inputs, four of them pickers over registered accounts and universe files. Reads the Postgres dataset, so the `db` container has to be up; writes to artifacts/tasks/backtest-run.log.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"backtest",
				"--strategy",
				"${input:btStrategy}",
				"--account",
				"${input:btAccount}",
				"--universe-file",
				"${input:btUniverseFile}",
				"--start",
				"${input:btStart}",
				"--eval-start",
				"${input:btEvalStart}",
				"--end",
				"${input:btEnd}"
			],
			"icon": {
				"id": "graph-line",
				"color": "terminal.ansiBrightBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Backtest: OOS (Honest Per-Fold)",
			"detail": "Walk-forward out-of-sample evaluation in the chosen ibkr_trader checkout; each fold trains only on data then available. Takes fewer inputs than 'Backtest: Run' on purpose — the warm-up and simulation starts are FIXED in scripts/backtest-task.py, because an OOS run whose windows move is not comparable to the last one. Separate artifact from 'Backtest: Run' so neither overwrites the other's evidence.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:ibkrCheckout}",
				"backtest-oos",
				"--account",
				"${input:btAccount}",
				"--end",
				"${input:oosEnd}"
			],
			"icon": {
				"id": "graph",
				"color": "terminal.ansiBrightMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		// --- scoped: the checkouts that have a database -----------------------
		{
			// The last task to leave a .vscode/tasks.json anywhere, and the only one
			// that lived in the GENERATOR template rather than a live repo. Its
			// picker spans four checkouts rather than two because two separate repos
			// have an Alembic tree; devkit is absent because it has no database.
			"label": "DB: New Migration (Autogenerate)",
			"detail": "`alembic revision --autogenerate` from the current model diff in the chosen checkout. ALWAYS READ THE GENERATED FILE before committing it — autogenerate is a diff, not a design: it misses renames (it sees a drop plus an add) and gets some constraint and type changes wrong. Writes one file into the migrations tree and NOTHING else — it never runs `upgrade`, so the database is untouched. The database does have to be UP, though: it compares the models against a live schema, and pointed at a stopped or stale one it will confidently propose dropping everything it cannot see.",
			"type": "process",
			"command": "python",
			"args": [
				"${workspaceFolder:devkit}/scripts/devkit_project.py",
				"--project",
				"${input:dbCheckout}",
				"db-revision",
				"-m",
				"${input:migrationMessage}"
			],
			"icon": {
				"id": "database",
				"color": "terminal.ansiBrightRed"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		// --- workspace-scoped: act across every checkout ---------------------
		{
			"label": "Project: New from devkit",
			"detail": "Scaffold a whole new project — templates, Docker stack on registry-allocated ports, vendored devkit harness, parallel worktree, PR gate, and a PRIVATE GitHub repo. Registers it in this workspace's folder list and project picker. DRY RUN by default: pick 'Apply' to actually write.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Project: New from devkit",
				"--",
				"python",
				"scripts/new-project.py",
				"${input:newProjectName}",
				"--preset",
				"${input:newProjectPreset}",
				"--description",
				"${input:newProjectDescription}",
				"${input:newProjectRemote}",
				"${input:newProjectApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "new-folder",
				"color": "terminal.ansiCyan"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"clear": true,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ship: Sweep Workspace — read-only",
			"detail": "Which checkouts still have work in them, and the next action for each. Touches nothing. Fetches every remote, so it takes a few seconds — pick 'Skip fetch' for an instant answer with possibly stale ahead/behind counts.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Ship: Sweep Workspace",
				"--",
				"python",
				"scripts/sweep.py",
				"${input:sweepFetch}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "search",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ship: Check Workspace — fail on stranded work",
			"detail": "The same read-only sweep, but the exit code is the answer: 0 nothing stranded, 1 a checkout needs action, 2 one is blocked. Touches nothing. Use it as a pre-flight before handing work to an agent.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Ship: Check Workspace",
				"--",
				"python",
				"scripts/sweep.py",
				"--check",
				"${input:sweepFetch}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "verified",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ship: Branch Stranded Work (step 1)",
			"detail": "DRY RUN by default. Cuts a claude/sweep-<mmdd> branch under work sitting on a branch it can't be shipped from (the default branch, or a worktree anchor like carameli-b). Leaves checkouts already on a task branch alone. Names them all `sweep` because one run spans every repo — pass --slug on the CLI when you are sweeping a single project and have something better to call it. This only moves work onto a branch; step 2 commits and opens the PRs.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Ship: Branch Stranded Work",
				"--",
				"python",
				"scripts/sweep.py",
				"--branch",
				"${input:sweepScope}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "git-branch",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ship: Publish Swept Work (step 2)",
			"detail": "DRY RUN by default. Commits whatever sits on each claude/… branch, pushes it, and opens a DRAFT PR. Asks nothing else — each commit takes its topic from the branch it is on. Nothing reads the diff, so the message describes the sweep, not the change: this is for making sure nothing is stranded, not for work you want reviewed as-is. Use /ship per repo for that. Never force-pushes, never bypasses a hook, and reuses a PR that is already open.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Ship: Publish Swept Work",
				"--",
				"python",
				"scripts/sweep.py",
				"--ship",
				"${input:sweepScope}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "git-pull-request",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Devkit: Upgrade a Project",
			"detail": "DRY RUN by default. Adopts the devkit release currently tagged in the devkit checkout: pulls the vendored files and moves all four pins together (files, DEVKIT_VERSION, the pre-commit rev, the PR-gate ref), then commits, pushes, and opens a draft PR of its own. Pick 'All projects' to do that everywhere at once — one PR per repo, skipping devkit itself, anything that never vendored, and the second worktree of a repo already upgraded in the run. Refuses a dirty project or an untagged devkit — an upgrade is its own change, never mixed into work in progress — and one refusal does not stop the rest.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Devkit: Upgrade a Project",
				"--",
				"python",
				"scripts/upgrade-project.py",
				"${input:upgradeScope}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "package",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ship: Sync Worktrees (step 3)",
			"detail": "DRY RUN by default. Once the PRs are merged: returns each worktree to its home branch, fast-forwards it, and deletes the merged claude/… branches. Refuses any checkout still holding unshipped work, so 'All checkouts' is safe to run while others are mid-flight — scope it to one when you are retrying the repo a sweep could not finish. Never force-deletes and never rewrites history.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/notify-wrap.py",
				"Ship: Sync Worktrees",
				"--",
				"python",
				"scripts/sweep.py",
				"--sync",
				"${input:sweepScope}",
				"${input:sweepApply}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "sync",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ports: Show A Checkout's Allocation",
			"detail": "Prints the *_HOST_PORT block ports.toml assigns to a checkout. Use it to rebuild a project's .env after a worktree change rather than picking a free-looking number.",
			"type": "process",
			"command": "python",
			"args": [
				"scripts/devkit_ports.py",
				"${input:project}"
			],
			"options": {
				"cwd": "${workspaceFolder:devkit}"
			},
			"icon": {
				"id": "plug",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Agents: Open Tabs (External Terminal)",
			"detail": "Choose Claude or Codex, then open a new Windows Terminal window with one tab per worktree. Machine-scoped, so it takes no project. The Carameli tabs also mount ../VanillaLand as writable.",
			"type": "process",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder:devkit}/scripts/launch-agent-tabs.ps1",
				"-Agent",
				"${input:agentCli}"
			],
			"icon": {
				"id": "rocket",
				"color": "terminal.ansiMagenta"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"clear": true,
				"close": true
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			// MAINTAINED BY new-project.py — it appends each new project here at the
			// same time it adds the folder above. VS Code cannot generate pickString
			// options at runtime (microsoft/vscode#81370), so the list is written
			// rather than derived. It is not authoritative: devkit_project.py
			// validates the answer against `folders` and rejects a stale entry by
			// name, so drift here is a UX annoyance, never a wrong-directory run.
			"id": "project",
			"type": "pickString",
			"description": "Which checkout to run this in",
			"options": [
				"carameli",
				"carameli-b",
				"ibkr_trader",
				"ibkr_trader-b",
				"devkit",
				"data-lake"
			],
			"default": "carameli"
		},
		{
			// Every project's run-tests.py accepts both of these, which is what lets
			// this be a picker rather than a free-text box. `--changed` is the
			// canonical spelling everywhere — devkit, the template, and the vendored
			// Stop hook's own remediation line. carameli used to spell it `--fast`,
			// which meant the Stop hook's advice died on "Unknown argument"; it now
			// accepts `--changed` and keeps `--fast` as a deprecated alias.
			//
			// The empty value is safe HERE specifically: devkit_project.py drops empty
			// arguments before exec, so it cannot reach argparse as a stray positional
			// (tests/test_devkit_project.py pins that). A picker feeding a script
			// directly still needs one real token per branch.
			"id": "testScope",
			"type": "pickString",
			"description": "How much of the suite to run",
			"options": [
				{
					"label": "Full suite (default)",
					"value": ""
				},
				{
					"label": "Changed only — the working-tree diff",
					"value": "--changed"
				}
			],
			"default": ""
		},
		{
			// The two-option pickers for the project-SCOPED tasks. Deliberately not
			// the `project` picker above: three of the five checkouts it lists cannot
			// run a Playwright suite, and offering them would make the wrong answer
			// available at exactly the moment you are least likely to notice. The
			// dispatcher validates the same restriction from its side
			// (`Action.projects`), so these lists are UX, never the guarantee.
			//
			// The default is the primary checkout in both cases. `-b` is the parallel
			// worktree — reachable in one keystroke, but never what you get by
			// pressing Enter through the picker.
			"id": "carameliCheckout",
			"type": "pickString",
			"description": "Which carameli checkout to run this in",
			"options": [
				"carameli",
				"carameli-b"
			],
			"default": "carameli"
		},
		{
			"id": "ibkrCheckout",
			"type": "pickString",
			"description": "Which ibkr_trader checkout to run this in",
			"options": [
				"ibkr_trader",
				"ibkr_trader-b"
			],
			"default": "ibkr_trader"
		},
		{
			// Four options, not two: `db-revision` is the one scoped action that
			// spans two repos, because both have an Alembic tree. devkit is absent
			// because it has no database (`[db] enabled = false`), and it is absent
			// from `DB_PROJECTS` for the same reason — the two lists have to agree,
			// and a test asserts they do.
			"id": "dbCheckout",
			"type": "pickString",
			"description": "Which checkout to generate the migration in",
			"options": [
				"carameli",
				"carameli-b",
				"ibkr_trader",
				"ibkr_trader-b"
			],
			"default": "carameli"
		},
		{
			// Free text, and it reaches a shell inside carameli's app container (the
			// PgBouncer bypass needs `sh -c` to expand $DIRECT_DATABASE_URL), so that
			// script quotes it. ibkr_trader's passes it as its own argv element and
			// never involves a shell at all.
			"id": "migrationMessage",
			"type": "promptString",
			"description": "Short description of the schema change (becomes part of the migration filename)",
			"default": ""
		},
		{
			// `hook-tests` is absent: it is the workspace's own "Test: Harness Hook
			// Tests" now, identical in every consumer, and a second spelling of it
			// here would be a third copy of the same run.
			"id": "carameliTestTarget",
			"type": "pickString",
			"description": "Which Carameli-only free target to run",
			"options": [
				{
					"label": "All free targets (pytest + hooks + frontend), one merged artifact",
					"value": "--all"
				},
				{
					"label": "Frontend (Vitest)",
					"value": "--target=frontend-tests"
				},
				{
					"label": "Public webhook reachability",
					"value": "--target=webhook-e2e"
				}
			],
			"default": "--all"
		},
		{
			// Carries an empty branch, and is safe for the same reason `testScope`
			// is: it feeds `devkit_project.py`, which drops empty arguments before
			// exec. While this picker lived in carameli's own task file it fed
			// `run-e2e.py` directly and survived only because that script happens to
			// test membership rather than parse arguments — an accident, and one of
			// the things hoisting these actually FIXED.
			"id": "e2eMode",
			"type": "pickString",
			"description": "Which Playwright mode to run",
			"options": [
				{
					"label": "Headless (default)",
					"value": ""
				},
				{
					"label": "Headed — watch the browser",
					"value": "--headed"
				},
				{
					"label": "Cross-browser — Chromium, Firefox, WebKit",
					"value": "--cross-browser"
				}
			],
			"default": ""
		},
		{
			"id": "ingestSource",
			"type": "pickString",
			"description": "Which data source to pull",
			"options": [
				{ "label": "FMP prices — batch", "value": "fmp-prices-batch" },
				{ "label": "FMP prices — one symbol", "value": "fmp-price-one" },
				{ "label": "Yahoo prices — batch", "value": "yahoo-prices-batch" },
				{ "label": "Yahoo fundamentals — batch", "value": "yahoo-fundamentals-batch" },
				{ "label": "Alpha Vantage prices — batch", "value": "alpha-vantage-batch" },
				{ "label": "Finnhub news — batch", "value": "finnhub-news-batch" },
				{ "label": "Finnhub news — one symbol", "value": "finnhub-news-one" },
				{ "label": "NewsAPI headlines — batch", "value": "newsapi-batch" },
				{ "label": "Google Trends — batch", "value": "trends-batch" },
				{ "label": "Google Trends — one keyword", "value": "trends-one" },
				{ "label": "Reddit", "value": "reddit" },
				{ "label": "FMP FX — one pair", "value": "fmp-fx" },
				{ "label": "Yahoo FX — deep-history backfill", "value": "yahoo-fx-backfill" }
			],
			"default": "fmp-prices-batch"
		},
		{
			// Consumed as `--arg=${input:ingestArg}`, one token, NOT as a separate
			// `--arg` flag followed by this value. An empty answer is the common case
			// (ten of the thirteen sources ignore it), and as two tokens the empty one
			// is dropped in transit, leaving a dangling `--arg` for argparse to
			// misread. `--arg=` with nothing after it is unambiguous.
			"id": "ingestArg",
			"type": "promptString",
			"description": "Optional symbol, keyword, or FX pair for single-item modes",
			"default": ""
		},
		{
			// Every branch supplies one real token — `--full` is redundant against
			// the script's own default and exists for exactly that reason.
			"id": "snapshotScope",
			"type": "pickString",
			"description": "Full ritual, or re-run just the snapshot over data already ingested?",
			"options": [
				{
					"label": "Full ritual — migrations, prices, aggregation, snapshot",
					"value": "--full"
				},
				{
					"label": "Snapshot only — skip the price ingests",
					"value": "--skip-ingest"
				},
				{
					"label": "Dry run — print the plan, run nothing",
					"value": "--dry-run"
				}
			],
			"default": "--full"
		},
		{
			"id": "btStrategy",
			"type": "pickString",
			"description": "Allocator to simulate",
			"options": [
				"ml_lt_ridge",
				"ml_lt",
				"momentum_lt",
				"equal_weight",
				"buy_and_hold"
			],
			"default": "ml_lt_ridge"
		},
		{
			// Shared by both Backtest tasks — the account is the one input the OOS
			// run still takes, since which account you evaluate does not affect
			// whether two OOS runs are comparable.
			"id": "btAccount",
			"type": "pickString",
			"description": "Registered account to simulate",
			"options": [
				"tfsa",
				"rrsp",
				"fhsa",
				"lira",
				"nonreg"
			],
			"default": "tfsa"
		},
		{
			"id": "btUniverseFile",
			"type": "pickString",
			"description": "Universe file",
			"options": [
				{ "label": "tickers-etfs.txt — ETF floor", "value": "tickers-etfs.txt" },
				{ "label": "tickers.txt — stocks + ETFs", "value": "tickers.txt" }
			],
			"default": "tickers-etfs.txt"
		},
		{
			"id": "btStart",
			"type": "promptString",
			"description": "Bar-load start",
			"default": "2008-06-02"
		},
		{
			"id": "btEvalStart",
			"type": "promptString",
			"description": "First decision date",
			"default": "2010-01-04"
		},
		{
			"id": "btEnd",
			"type": "promptString",
			"description": "Window end",
			"default": "2030-01-01"
		},
		{
			"id": "oosEnd",
			"type": "promptString",
			"description": "OOS dataset window end",
			"default": "2026-07-01"
		},
		{
			// Every branch supplies one real token — `--check` rather than "" for
			// the default — for the reason spelled out on `newProjectRemote` below.
			"id": "harnessMode",
			"type": "pickString",
			"description": "Drift-check, adopt upstream, or push a change authored here",
			"options": [
				{
					"label": "Check for drift (safe, read-only)",
					"value": "--check"
				},
				{
					"label": "Pull — adopt devkit's version, overwriting local",
					"value": "--pull"
				},
				{
					"label": "Push — send this repo's version up to devkit",
					"value": "--push"
				},
				{
					"label": "List the manifest + vendored version",
					"value": "--list"
				}
			],
			"default": "--check"
		},
		{
			"id": "newProjectName",
			"type": "promptString",
			"description": "New project name — becomes the directory, the Python package, and COMPOSE_PROJECT_NAME",
			"default": ""
		},
		{
			"id": "newProjectPreset",
			"type": "pickString",
			"description": "Project shape. Individual features can be added later with --with-* flags.",
			"options": [
				{
					"label": "service — Docker + app + Postgres + Alembic",
					"value": "service"
				},
				{
					"label": "service-redis — the above plus Redis",
					"value": "service-redis"
				},
				{
					"label": "data — Postgres + the data-lake archive seam (ibkr_trader's shape)",
					"value": "data"
				},
				{
					"label": "fullstack — service-redis plus a Vite frontend (carameli's shape)",
					"value": "fullstack"
				},
				{
					"label": "bare — no Docker, no database; just the harness and CI",
					"value": "bare"
				}
			],
			"default": "service"
		},
		{
			"id": "newProjectDescription",
			"type": "promptString",
			"description": "One-line description (goes into README.md, CLAUDE.md, and pyproject.toml)",
			"default": ""
		},
		{
			// Both pickers supply one real token in every branch, never "". An empty
			// string in an args array reaches argparse as a stray positional and is
			// rejected — which is why new-project.py carries the redundant-looking
			// `--dry-run` and `--remote` flags alongside their negations.
			"id": "newProjectRemote",
			"type": "pickString",
			"description": "Create a PRIVATE GitHub repo and push? (ignored on a dry run)",
			"options": [
				{
					"label": "Yes — create alexandrec90/<name> as private, and push",
					"value": "--remote"
				},
				{
					"label": "No — local only, wire up the remote later",
					"value": "--no-remote"
				}
			],
			"default": "--remote"
		},
		{
			"id": "newProjectApply",
			"type": "pickString",
			"description": "Dry run prints the full plan and writes nothing. Run it once before applying.",
			"options": [
				{
					"label": "Dry run — print the plan, write nothing",
					"value": "--dry-run"
				},
				{
					"label": "Apply — write files, init git, add the worktree",
					"value": "--yes"
				}
			],
			"default": "--dry-run"
		},
		{
			"id": "sweepFetch",
			"type": "pickString",
			"description": "Fetch every remote first?",
			"options": [
				{
					"label": "Fetch — accurate ahead/behind counts (slower)",
					"value": "--fetch"
				},
				{
					"label": "Skip fetch — instant, counts may be stale",
					"value": "--no-fetch"
				}
			],
			"default": "--fetch"
		},
		{
			// HAND-MAINTAINED, unlike `project` above — `new-project.py` extends the
			// folder list and the `project` picker and nothing else, so a generated
			// project used to arrive unable to be swept on its own. data-lake was
			// exactly that: `--all` reached it, but the one-checkout retry these three
			// steps exist for was CLI-only for it. `test_every_scope_picker_can_aim_at
			// _every_checkout` now compares this list against the `project` picker, so
			// the next omission fails devkit's suite instead of being noticed in use.
			"id": "sweepScope",
			"type": "pickString",
			"description": "Every checkout, or just one?",
			"options": [
				{ "label": "All checkouts", "value": "--all" },
				{ "label": "carameli only", "value": "--only=carameli" },
				{ "label": "carameli-b only", "value": "--only=carameli-b" },
				{ "label": "ibkr_trader only", "value": "--only=ibkr_trader" },
				{ "label": "ibkr_trader-b only", "value": "--only=ibkr_trader-b" },
				{ "label": "devkit only", "value": "--only=devkit" },
				{ "label": "data-lake only", "value": "--only=data-lake" }
			],
			"default": "--all"
		},
		{
			// Separate from `project` above, which several single-checkout tasks share
			// and where "every project" would be meaningless. Every branch emits one
			// real token — `--all` rather than "" — because an empty string reaches
			// argparse as a stray positional. devkit is absent on purpose: it is the
			// source the release is pulled *from*, and naming it is rejected — that
			// exclusion is written down in `SCOPE_PICKERS` in tests/test_devkit_project.py,
			// which otherwise requires this list to cover every checkout. Being listed
			// here is not a claim that a project HAS vendored devkit; `--all` skips the
			// ones that have not, and a named one that has not is refused by name.
			"id": "upgradeScope",
			"type": "pickString",
			"description": "Which checkouts should adopt the devkit release?",
			"options": [
				{
					"label": "All projects — every checkout that has vendored devkit",
					"value": "--all"
				},
				{ "label": "carameli only", "value": "carameli" },
				{ "label": "carameli-b only", "value": "carameli-b" },
				{ "label": "ibkr_trader only", "value": "ibkr_trader" },
				{ "label": "ibkr_trader-b only", "value": "ibkr_trader-b" },
				{ "label": "data-lake only", "value": "data-lake" }
			],
			"default": "--all"
		},
		{
			"id": "sweepApply",
			"type": "pickString",
			"description": "Dry run, or actually change the checkouts?",
			"options": [
				{
					"label": "Dry run — print the plan, change nothing",
					"value": "--dry-run"
				},
				{
					"label": "Apply — run the git commands shown",
					"value": "--yes"
				}
			],
			"default": "--dry-run"
		},
		{
			"id": "agentCli",
			"type": "pickString",
			"description": "Coding agent CLI to open in every worktree tab",
			"options": [
				"claude",
				"codex"
			],
			"default": "claude"
		}
	]
}
